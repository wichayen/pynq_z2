
IMAGE_FEATURES:append = " x11-base tools-sdk dev-pkgs"

IMAGE_INSTALL:append = " \
    xserver-xorg \
    xserver-nodm-init \
    xf86-input-libinput \
    xf86-input-evdev \
    xf86-video-fbdev \
    openbox \
    xterm \
    libdrm-tests \
    evtest \
    usbutils \
    gcc \
    make \
    binutils \
"

# FM SDR application: libusb for librtlsdr and i2c tools. The application, the sdr_dma module and
# librtlsdr are built outside PetaLinux (see fm_sdr/README.md), so they are not installed here.
IMAGE_INSTALL:append = " \
    libusb1 \
    i2c-tools \
"
